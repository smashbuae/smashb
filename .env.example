# Google Tag Manager Container ID (defaults to GTM-TJNTGJM3 in index.html)
VITE_GTM_ID=GTM-TJNTGJM3

# Optional direct Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA4_ID=

# Optional direct Google Ads Conversion ID (e.g. AW-XXXXXXXXX)
VITE_GADS_ID=

# Optional Google Ads Conversion Label
VITE_GADS_CONVERSION_LABEL=
